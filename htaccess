# Begin EnforceSSL southernfirefliesretreats.com
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?southernfirefliesretreats\.com$
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L]
</IfModule>
# End EnforceSSL

DirectoryIndex index.php index.html

# Old bookmarks to /index.html (from before the site ran on index.php)
# always land here instead of on stale content. Uses mod_alias, a
# separate/simpler mechanism from the SSL rewrite rules above - fires
# on the exact literal path only, so it's safe alongside the
# maintenance-page swap process (renaming index.php away and dropping
# content at index.html): a direct hit on /index.html still bounces to
# "/", which then correctly shows whichever is actually live right now.

Redirect 301 /index.html /